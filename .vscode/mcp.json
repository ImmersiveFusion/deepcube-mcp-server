{
   "inputs": [
    {
      "type": "promptString",
      "id": "if-key",
      "description": "DeepCube API Key",
      "password": true
    }
  ],
  "servers": {
    "deepcube": {
      "type": "stdio",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/IF.APM.App.MCP.Server/IF.APM.App.MCP.Server.csproj"
      ],
       "env": {
        "IF_ApiKey": "${input:if-key}"
      }
    }
  }
}