<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    This repository is public OSS and builds on GitHub-hosted runners.
    Restore from nuget.org only: every dependency, including
    IF.APM.App.Http.Api.Client, is published publicly. Clearing inherited
    sources keeps a developer's private feeds out of the restore graph so a
    local build matches CI exactly.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
